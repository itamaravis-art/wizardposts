# ===== Web (Vercel) =====
# Database — Supabase Postgres connection string
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Supabase — for Storage (image uploads)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# NextAuth
AUTH_SECRET=run_openssl_rand_base64_32_to_generate
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# ===== Worker =====
# The worker token (created in the UI per-user)
WORKER_TOKEN=wt_xxxxx
# The cloud API base URL
API_BASE_URL=https://wizardposts.vercel.app

# Browser config
BROWSER_USER_DATA_DIR=./data/session
BROWSER_LOCALE=he-IL
BROWSER_TIMEZONE=Asia/Jerusalem

# Logging
LOG_LEVEL=info
