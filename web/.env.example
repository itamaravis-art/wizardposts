# Copy this file to .env.local and fill in the values.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser bundle —
# never put a secret there.

# ──────────────────────────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database — Supabase Session Pooler (IPv4 compatible).
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ──────────────────────────────────────────────────────────────────
# NextAuth
# ──────────────────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=https://wizardposts.vercel.app
NEXTAUTH_URL=https://wizardposts.vercel.app

# Google OAuth (for sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────
# AI generation (page-channel module — einatural)
# Used by /api/cron/generate to produce captions + images.
# ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ──────────────────────────────────────────────────────────────────
# Facebook Graph API (page-channel module)
# App created in Meta for Developers → Business type → Pages API.
# Development Mode is sufficient because the user owns the Page.
# ──────────────────────────────────────────────────────────────────
FB_APP_ID=
FB_APP_SECRET=

# ──────────────────────────────────────────────────────────────────
# Encryption key for at-rest secrets (FB Page access tokens, etc.).
# Generate ONCE with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotation is a separate workflow — don't change this carelessly,
# all encrypted rows stop decrypting if you do.
# ──────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ──────────────────────────────────────────────────────────────────
# Green API (WhatsApp notifications to page owner)
# https://green-api.com — instance + token from your account dashboard.
# ──────────────────────────────────────────────────────────────────
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Page owner's WhatsApp number in international format, NO leading +
# e.g. for 050-6810353 use 972506810353
OWNER_WHATSAPP=

# ──────────────────────────────────────────────────────────────────
# Storage bucket for AI-generated images (page-channel).
# Create the bucket in Supabase Storage with PUBLIC READ before first run.
# ──────────────────────────────────────────────────────────────────
SUPABASE_PAGE_IMAGES_BUCKET=page-images

# ──────────────────────────────────────────────────────────────────
# Optional: shortlink host override (for custom domain setup later).
# Defaults to NEXT_PUBLIC_BASE_URL or wizardposts.vercel.app.
# ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SHORTLINK_HOST=wizardposts.vercel.app
