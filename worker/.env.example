# Worker token issued from your account at the cloud dashboard.
# Format: wp_<random>. Generate one at https://wizardposts.vercel.app/worker
WORKER_TOKEN=wp_replace_me_with_your_real_token

# Cloud API root (no trailing slash).
API_BASE_URL=https://wizardposts.vercel.app

# Optional human-friendly name for this worker (defaults to OS hostname).
# WORKER_NAME=

# Logging level: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Browser (Playwright) settings ---
# Run Chromium headless? Recommended: false on first connect, true once cookies are saved.
BROWSER_HEADLESS=false
BROWSER_LOCALE=he-IL
BROWSER_TIMEZONE=Asia/Jerusalem
# Override Chromium UA if you want a different fingerprint.
# BROWSER_USER_AGENT=
