{
  "name": "wizardposts-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local worker that polls the cloud API and posts to Facebook groups",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "connect": "tsx --env-file=.env src/browser/connect.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "zod": "^3.23.8",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
